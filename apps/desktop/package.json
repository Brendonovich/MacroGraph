{
	"name": "@macrograph/desktop",
	"main": "dist-electron/main.js",
	"scripts": {
		"dev:renderer": "vinxi dev",
		"dev:electron": "wait-on http://localhost:3000 && electron . --dev",
		"dev": "concurrently -n renderer,electron \"pnpm dev:renderer\" \"pnpm dev:electron\"",
		"build:remote": "pnpm --filter @macrograph/remote-editor build",
		"build:renderer": "vinxi build",
		"build:electron": "tsc -p electron/tsconfig.json",
		"build": "pnpm build:remote && pnpm build:renderer && pnpm build:electron",
		"build:app": "pnpm build && electron-builder",
		"start": "electron .",
		"typecheck": "tsc -b"
	},
	"dependencies": {
		"@iconify/json": "^2.2.196",
		"@kobalte/core": "^0.13.7",
		"@macrograph/api-contract": "workspace:*",
		"@macrograph/interface": "workspace:*",
		"@macrograph/packages": "workspace:*",
		"@macrograph/runtime": "workspace:*",
		"@macrograph/runtime-serde": "workspace:*",
		"@macrograph/ui": "workspace:*",
		"@solid-primitives/scheduled": "^1.4.3",
		"@solid-primitives/storage": "^2.1.4",
		"@solidjs/router": "^0.14.3",
		"@solidjs/start": "1.1.3",
		"@t3-oss/env-core": "^0.6.1",
		"@tanstack/solid-query": "^4.36.1",
		"@ts-rest/core": "^3.52.1",
		"@ts-rest/solid-query": "^3.41.1",
		"coap-packet": "^1.1.1",
		"express": "^5.2.1",
		"form-data": "^4.0.5",
		"node-dtls-client": "^2.0.2",
		"obs-websocket-js": "^5.0.5",
		"solid-js": "^1.9.5",
		"solid-sonner": "^0.2.5",
		"tiktok-live-connector": "1.2.3",
		"uiohook-napi": "^1.5.5",
		"uuid": "^14.0.0",
		"valibot": "^0.37.0",
		"vinxi": "0.4.1",
		"ws": "^8.21.0",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@kobalte/tailwindcss": "^0.6.5",
		"@macrograph/config": "workspace:*",
		"@tailwindcss/forms": "^0.5.7",
		"@types/ws": "^8.18.1",
		"autoprefixer": "^10.4.19",
		"concurrently": "^10.0.0",
		"electron": "^42.3.0",
		"electron-builder": "^26.8.1",
		"postcss": "^8.4.38",
		"tailwindcss": "^3.4.3",
		"unplugin-auto-import": "^0.17.5",
		"unplugin-icons": "^0.18.5",
		"vite": "^5.4.0",
		"wait-on": "^9.0.10"
	}
}
